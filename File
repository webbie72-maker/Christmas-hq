    if (!mast) return;

    const tab = (window.ui && window.ui.tab) || 'home';
    const key = panelImages[tab] ? tab : 'home';
    const url = panelImages[key];

    mast.style.backgroundImage = `url("${url}")`;
    mast.dataset.hqPage = key;

    addSnow(mast);
  }

  const observer = new MutationObserver(() => {
    setTimeout(applyPanel, 0);
  });

  observer.observe(document.documentElement, {
    childList: true,
    subtree: true,
    attributes: true
  });

  document.addEventListener('click', () => {
    setTimeout(applyPanel, 50);
  }, true);

  applyPanel();
